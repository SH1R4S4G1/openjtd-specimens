{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenJTD Sample Catalog v1",
  "description": "Declarative final document requirements; implementation steps are not accepted. Semantic validation is also required.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "samples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sample"
      },
      "minItems": 1,
      "maxItems": 200
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "samples"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[a-z][a-z0-9-]*$(?![\\s\\S])"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59999
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\uD800-\\uDFFF\\u{10000}-\\u{10FFFF}\\p{M}]+$(?![\\s\\S])"
        }
      },
      "required": [
        "start",
        "end",
        "text"
      ]
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\uD800-\\uDFFF\\u{10000}-\\u{10FFFF}]+$(?![\\s\\S])"
        },
        "sizePt": {
          "type": "number",
          "minimum": 5,
          "maximum": 50
        }
      },
      "required": [],
      "minProperties": 1
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "percent": {
          "type": "number",
          "minimum": 50,
          "maximum": 200
        }
      },
      "required": [
        "percent"
      ]
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "points": {
          "type": "number",
          "minimum": 3,
          "maximum": 500
        }
      },
      "required": [
        "points"
      ]
    },
    "spacing": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number",
              "minimum": -176.4,
              "maximum": 176.4
            },
            "unit": {
              "const": "mm"
            }
          },
          "required": [
            "value",
            "unit"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number",
              "minimum": -200,
              "maximum": 200
            },
            "unit": {
              "const": "percent"
            }
          },
          "required": [
            "value",
            "unit"
          ]
        }
      ]
    },
    "closely": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "evenly": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100
        },
        "unit": {
          "enum": [
            "mm",
            "inch",
            "point",
            "character"
          ]
        }
      },
      "required": [
        "width",
        "unit"
      ]
    },
    "ruby": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alignment": {
          "description": "読みの文字揃え。省略時は一太郎APIの既定動作を利用し実値を記録。placement（上下配置）とは独立。",
          "enum": [
            "distributed",
            "left",
            "center",
            "right"
          ]
        },
        "reading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\uD800-\\uDFFF\\u{10000}-\\u{10FFFF}\\p{M}]+$(?![\\s\\S])"
        },
        "placement": {
          "enum": [
            "above",
            "below"
          ]
        },
        "sizeMm": {
          "type": "number",
          "minimum": 3,
          "maximum": 10
        },
        "distanceMm": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "reading"
      ]
    },
    "decoration": {
      "type": "object",
      "additionalProperties": false,
      "description": "Final decoration state of the range. Specify at least one of underline, strikeThrough or fill. Line types and fill patterns are Ichitaro codes verified by getter; appearance is not identified. color is one decoration color shared by every decoration on the range.",
      "properties": {
        "underline": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "strikeThrough": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "fill": {
          "type": "integer",
          "minimum": 1,
          "maximum": 107
        },
        "color": {
          "$ref": "#/$defs/rgb"
        }
      },
      "required": [],
      "minProperties": 1
    },
    "border": {
      "type": "object",
      "additionalProperties": false,
      "description": "Character border (文字囲み) line type code. color is the decoration color shared with other decorations on the same characters.",
      "properties": {
        "lineType": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "color": {
          "$ref": "#/$defs/rgb"
        }
      },
      "required": [
        "lineType"
      ]
    },
    "fontStyle": {
      "type": "object",
      "additionalProperties": false,
      "description": "Japanese font style of the range: regular, bold or italic (read back as the style name 標準/太字/斜体). Bold and italic cannot be combined.",
      "properties": {
        "style": {
          "enum": [
            "regular",
            "bold",
            "italic"
          ]
        }
      },
      "required": [
        "style"
      ]
    },
    "textColor": {
      "type": "object",
      "additionalProperties": false,
      "description": "Text color of the range.",
      "properties": {
        "color": {
          "$ref": "#/$defs/rgb"
        }
      },
      "required": [
        "color"
      ]
    },
    "fontName": {
      "type": "object",
      "additionalProperties": false,
      "description": "Japanese font name of the range. Must be installed; otherwise Ichitaro does not apply it and the readback fails.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$(?![\\s\\S])"
        }
      },
      "required": [
        "name"
      ]
    },
    "annotation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capability": {
              "const": "character-scaleX"
            },
            "range": {
              "$ref": "#/$defs/range"
            },
            "parameters": {
              "$ref": "#/$defs/scale"
            }
          },
          "required": [
            "capability",
            "range",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capability": {
              "const": "character-size"
            },
            "range": {
              "$ref": "#/$defs/range"
            },
            "parameters": {
              "$ref": "#/$defs/size"
            }
          },
          "required": [
            "capability",
            "range",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capability": {
              "const": "character-spacing"
            },
            "range": {
              "$ref": "#/$defs/range"
            },
            "parameters": {
              "$ref": "#/$defs/spacing"
            }
          },
          "required": [
            "capability",
            "range",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capability": {
              "const": "closely-spacing"
            },
            "range": {
              "$ref": "#/$defs/range"
            },
            "parameters": {
              "$ref": "#/$defs/closely"
            }
          },
          "required": [
            "capability",
            "range",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capability": {
              "const": "evenly-spacing"
            },
            "range": {
              "$ref": "#/$defs/range"
            },
            "parameters": {
              "$ref": "#/$defs/evenly"
            }
          },
          "required": [
            "capability",
            "range",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capability": {
              "const": "ruby"
            },
            "range": {
              "$ref": "#/$defs/range"
            },
            "parameters": {
              "$ref": "#/$defs/ruby"
            }
          },
          "required": [
            "capability",
            "range",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capability": {
              "const": "character-decoration"
            },
            "range": {
              "$ref": "#/$defs/range"
            },
            "parameters": {
              "$ref": "#/$defs/decoration"
            }
          },
          "required": [
            "capability",
            "range",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capability": {
              "const": "character-border"
            },
            "range": {
              "$ref": "#/$defs/range"
            },
            "parameters": {
              "$ref": "#/$defs/border"
            }
          },
          "required": [
            "capability",
            "range",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capability": {
              "const": "character-font-style"
            },
            "range": {
              "$ref": "#/$defs/range"
            },
            "parameters": {
              "$ref": "#/$defs/fontStyle"
            }
          },
          "required": [
            "capability",
            "range",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capability": {
              "const": "character-color"
            },
            "range": {
              "$ref": "#/$defs/range"
            },
            "parameters": {
              "$ref": "#/$defs/textColor"
            }
          },
          "required": [
            "capability",
            "range",
            "parameters"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capability": {
              "const": "character-font"
            },
            "range": {
              "$ref": "#/$defs/range"
            },
            "parameters": {
              "$ref": "#/$defs/fontName"
            }
          },
          "required": [
            "capability",
            "range",
            "parameters"
          ]
        }
      ]
    },
    "textDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60000,
          "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f\\uD800-\\uDFFF\\u{10000}-\\u{10FFFF}\\p{M}]+$(?![\\s\\S])",
          "description": "1..60000 BMP characters. LF separates nonempty paragraphs; range offsets count the LF as one character and a range stays inside one paragraph. Up to 2000 characters, multi-paragraph text is read back character by character (horizontal writing only). Over 2000 characters (CR-003) the text is horizontal with at most 1000 paragraphs; annotations are read back character by character only in the paragraphs that hold them (at most 2000 characters in total), and the whole text is checked by the joined GetString lines, the line split at every paragraph end and a paragraph walk (first and last character and end of each paragraph), not character by character."
        },
        "font": {
          "$ref": "#/$defs/font"
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotation"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "style": {
          "$ref": "#/$defs/documentStyle"
        },
        "styleSource": {
          "$ref": "#/$defs/styleSource"
        },
        "page": {
          "$ref": "#/$defs/page"
        },
        "writingMode": {
          "$ref": "#/$defs/writingMode"
        },
        "columnFormat": {
          "$ref": "#/$defs/columnFormat"
        },
        "pageNumber": {
          "$ref": "#/$defs/pageNumber"
        },
        "typesetting": {
          "$ref": "#/$defs/typesetting"
        }
      },
      "required": [
        "kind",
        "text"
      ]
    },
    "tableDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "keisen-table"
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "lineType": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "color": {
          "$ref": "#/$defs/rgb"
        },
        "rowHeights": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 2,
            "maximum": 4
          },
          "minItems": 1,
          "maxItems": 4
        },
        "columnWidths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 4,
            "maximum": 10
          },
          "minItems": 1,
          "maxItems": 4
        },
        "merges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableMerge"
          },
          "minItems": 1,
          "maxItems": 4
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableCell"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "leadingParagraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/leadingParagraph"
          },
          "minItems": 1,
          "maxItems": 8,
          "description": "Body paragraphs before the table (CR-009), one page line each; the table follows them."
        },
        "font": {
          "$ref": "#/$defs/font"
        },
        "style": {
          "$ref": "#/$defs/documentStyle",
          "description": "Optional document style (CR-008), set before the table is drawn. Omitted: the default new-document form (40 characters, 40 lines, 30mm margins) as before."
        }
      },
      "required": [
        "kind",
        "rows",
        "columns"
      ]
    },
    "document": {
      "oneOf": [
        {
          "$ref": "#/$defs/textDocument"
        },
        {
          "$ref": "#/$defs/tableDocument"
        },
        {
          "$ref": "#/$defs/footnoteDocument"
        },
        {
          "$ref": "#/$defs/paragraphsDocument"
        }
      ]
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "property": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "property",
        "value"
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "feature": {
          "enum": [
            "plain-text",
            "document-style",
            "document-footnote",
            "document-font",
            "character-scaleX",
            "character-size",
            "character-spacing",
            "closely-spacing",
            "evenly-spacing",
            "ruby",
            "character-font-style",
            "character-color",
            "character-font",
            "character-decoration",
            "character-border",
            "document-header",
            "header-layout",
            "document-columns-body",
            "paragraph-attribute",
            "document-columns",
            "document-page",
            "document-typesetting",
            "document-paper",
            "document-layout",
            "document-style-source",
            "layout-frame",
            "paragraph-tabs",
            "named-styles",
            "keisen-table"
          ]
        },
        "testIntent": {
          "enum": [
            "parse",
            "regression",
            "boundary",
            "comparison"
          ]
        },
        "expected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expectation"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "relatedSamples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 20,
          "uniqueItems": true
        },
        "document": {
          "$ref": "#/$defs/document"
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Run the same request this many times as separate jobs <id>-r1..rn, each from its own baseline. At most 200 jobs per catalog including repeats."
        },
        "control": {
          "type": "boolean",
          "description": "Also save a control: the same baseline JTD reopened and saved unchanged under a new name, for measuring save-to-save variation."
        }
      },
      "required": [
        "id",
        "title",
        "purpose",
        "feature",
        "expected",
        "document"
      ]
    },
    "rgb": {
      "type": "string",
      "pattern": "^R(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])G(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])B(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])$(?![\\s\\S])"
    },
    "cellAttributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alignment": {
          "enum": [
            1,
            2,
            3,
            10
          ]
        },
        "textColor": {
          "$ref": "#/$defs/rgb"
        },
        "bold": {
          "enum": [
            0,
            1
          ]
        },
        "italic": {
          "enum": [
            0,
            1
          ]
        },
        "fill": {
          "type": "integer",
          "minimum": 0,
          "maximum": 107
        },
        "color": {
          "$ref": "#/$defs/rgb"
        }
      },
      "required": [],
      "minProperties": 1
    },
    "tableCell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "attributes": {
          "$ref": "#/$defs/cellAttributes"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4
        }
      },
      "required": [
        "row",
        "column"
      ],
      "minProperties": 3
    },
    "tableAddress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      },
      "required": [
        "row",
        "column"
      ]
    },
    "tableMerge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/tableAddress"
        },
        "to": {
          "$ref": "#/$defs/tableAddress"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "documentStyle": {
      "type": "object",
      "additionalProperties": false,
      "description": "Priority values and all margins are required. Optional dependent values are strict assertions; omitted dependent values are calculated by Ichitaro and recorded. Spacing: percent; margins: mm. Numeric bounds are guardrails, not a guarantee of feasible combinations.",
      "properties": {
        "chars": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "lines": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "characterSpacing": {
          "type": "number",
          "minimum": -10,
          "maximum": 100
        },
        "lineSpacing": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "marginTop": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "marginBottom": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "marginLeft": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "marginRight": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "layoutPriority": {
          "enum": [
            "counts",
            "spacing"
          ]
        }
      },
      "required": [
        "layoutPriority",
        "marginTop",
        "marginBottom",
        "marginLeft",
        "marginRight"
      ],
      "oneOf": [
        {
          "properties": {
            "layoutPriority": {
              "const": "counts"
            }
          },
          "required": [
            "chars",
            "lines"
          ]
        },
        {
          "properties": {
            "layoutPriority": {
              "const": "spacing"
            }
          },
          "required": [
            "characterSpacing",
            "lineSpacing"
          ]
        }
      ]
    },
    "footnote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,39}$(?![\\s\\S])"
        },
        "paragraph": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[^\\s\\p{C}\\p{M}\\uD800-\\uDFFF\\u{10000}-\\u{10FFFF}]+$(?![\\s\\S])"
        }
      },
      "required": [
        "id",
        "paragraph",
        "offset",
        "text"
      ]
    },
    "footnoteDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "footnotes"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 199,
          "description": "1..8 nonempty paragraphs separated by LF; each 1..24 non-whitespace BMP characters. Compiler validates each paragraph."
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/footnote"
          },
          "maxItems": 8,
          "minItems": 0
        }
      },
      "required": [
        "kind",
        "text",
        "notes"
      ]
    },
    "headerFooter": {
      "type": "object",
      "additionalProperties": false,
      "description": "Header (upper margin) or footer (lower margin) strings at the left (text), center and right on every page; evenPages gives different strings on even pages. Fixed 20mm margin. Only text (left) combines with other elements; center, right or evenPages make the header/footer the only element.",
      "properties": {
        "position": {
          "enum": [
            "header",
            "footer"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[^\\s\\p{C}\\p{M}\\uD800-\\uDFFF\\u{10000}-\\u{10FFFF}]+$(?![\\s\\S])"
        },
        "center": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[^\\s\\p{C}\\p{M}\\uD800-\\uDFFF\\u{10000}-\\u{10FFFF}]+$(?![\\s\\S])"
        },
        "right": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[^\\s\\p{C}\\p{M}\\uD800-\\uDFFF\\u{10000}-\\u{10FFFF}]+$(?![\\s\\S])"
        },
        "evenPages": {
          "type": "object",
          "additionalProperties": false,
          "description": "Strings on even pages (the document gets 2 pages, one per paragraph). Their order is verified; their slot cannot be read back.",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24,
              "pattern": "^[^\\s\\p{C}\\p{M}\\uD800-\\uDFFF\\u{10000}-\\u{10FFFF}]+$(?![\\s\\S])"
            },
            "center": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24,
              "pattern": "^[^\\s\\p{C}\\p{M}\\uD800-\\uDFFF\\u{10000}-\\u{10FFFF}]+$(?![\\s\\S])"
            },
            "right": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24,
              "pattern": "^[^\\s\\p{C}\\p{M}\\uD800-\\uDFFF\\u{10000}-\\u{10FFFF}]+$(?![\\s\\S])"
            }
          },
          "required": [],
          "minProperties": 1
        }
      },
      "required": [
        "position"
      ],
      "minProperties": 2
    },
    "paragraphsDocument": {
      "type": "object",
      "additionalProperties": false,
      "description": "Several short paragraphs with document-structure elements (at least one of headerFooter, columns, paragraphFormats, frames, notes, styles). headerFooter, columns, paragraphFormats and frames combine freely; notes combine only with a one-page headerFooter. Optional font, page and style apply to the whole document (horizontal writing). styles cannot combine with other elements.",
      "properties": {
        "kind": {
          "const": "paragraphs"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 199,
          "description": "1..8 nonempty paragraphs separated by LF; each 1..24 non-whitespace BMP characters. headerFooter requires exactly 3 paragraphs; columns and paragraphFormats require 3..8. Compiler validates each paragraph. A tab character (U+0009) may appear only when paragraphFormats is the only element."
        },
        "headerFooter": {
          "$ref": "#/$defs/headerFooter"
        },
        "pageBreaks": {
          "const": true,
          "description": "Put each of the 3 paragraphs on its own page (3 pages). Requires headerFooter."
        },
        "columns": {
          "$ref": "#/$defs/columnCount"
        },
        "paragraphFormats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/paragraphFormat"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/footnote"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "font": {
          "$ref": "#/$defs/font"
        },
        "page": {
          "$ref": "#/$defs/page"
        },
        "style": {
          "$ref": "#/$defs/documentStyle"
        },
        "columnFormat": {
          "$ref": "#/$defs/columnFormat"
        },
        "styles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "definitions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/styleDefinition"
              },
              "minItems": 1,
              "maxItems": 4
            },
            "applications": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/styleApplication"
              },
              "minItems": 0,
              "maxItems": 8
            }
          },
          "required": [
            "definitions"
          ]
        },
        "pageNumber": {
          "$ref": "#/$defs/pageNumber"
        },
        "columnRange": {
          "$ref": "#/$defs/columnRange"
        },
        "typesetting": {
          "$ref": "#/$defs/typesetting"
        }
      },
      "required": [
        "kind",
        "text"
      ]
    },
    "columnCount": {
      "enum": [
        2,
        3
      ],
      "description": "Whole-document horizontal columns."
    },
    "paragraphFormat": {
      "type": "object",
      "additionalProperties": false,
      "description": "Final paragraph attributes. Specify at least one of alignment, indent, spacing or tabs. Unspecified components of indent/spacing are written as 0.",
      "properties": {
        "paragraph": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7,
          "description": "Zero-based paragraph index."
        },
        "alignment": {
          "enum": [
            "left",
            "center",
            "right",
            "distributed"
          ]
        },
        "indent": {
          "type": "object",
          "additionalProperties": false,
          "description": "Paragraph indent. columns: 0..10, mm: 0..10. firstLineEnd is a nonpositive shift (-10..0).",
          "properties": {
            "unit": {
              "enum": [
                "mm",
                "columns"
              ]
            },
            "start": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "end": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "firstLineStart": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "firstLineEnd": {
              "type": "number",
              "minimum": -10,
              "maximum": 0
            }
          },
          "required": [
            "unit"
          ],
          "minProperties": 2
        },
        "spacing": {
          "type": "object",
          "additionalProperties": false,
          "description": "Space before/after the paragraph. mm: 0..10, percent: 0..100.",
          "properties": {
            "unit": {
              "enum": [
                "mm",
                "percent"
              ]
            },
            "before": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "after": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "unit"
          ],
          "minProperties": 2
        },
        "tabs": {
          "type": "object",
          "additionalProperties": false,
          "description": "Tab stop positions from the paragraph start, strictly increasing. mm: up to 60, columns: up to 20. Tab alignment is called as left but cannot be read back and is not verified.",
          "properties": {
            "unit": {
              "enum": [
                "mm",
                "columns"
              ]
            },
            "positions": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 60
              },
              "minItems": 1,
              "maxItems": 8
            }
          },
          "required": [
            "unit",
            "positions"
          ]
        }
      },
      "required": [
        "paragraph"
      ],
      "minProperties": 2
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "description": "Paper size and orientation (single sheet). Ichitaro adjusts layout values to fit the paper; combine with style to state them explicitly.",
      "properties": {
        "paper": {
          "enum": [
            "A3",
            "A4",
            "A5",
            "B4",
            "B5"
          ]
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape"
          ]
        }
      },
      "required": [
        "paper",
        "orientation"
      ]
    },
    "writingMode": {
      "enum": [
        "horizontal",
        "vertical"
      ],
      "description": "Document writing direction. Vertical writing cannot be combined with annotations."
    },
    "styleSource": {
      "enum": [
        "new-document"
      ],
      "description": "Keep the document style of a new Ichitaro document (CR-001): neither the baseline nor the sample calls a document style setter or SetDocumentStyle. Cannot combine with style, font, page, writingMode, columnFormat, pageNumber or typesetting. The style getter values are recorded before save and after reopening and must agree; they are not compared with requested values."
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "description": "A named fixed layout frame (レイアウトボックス) on page 1 of an A4 portrait document. Geometry in mm from the paper top-left; Ichitaro snaps edges by up to about 1.25mm and the observed values are recorded.",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$(?![sS])"
        },
        "left": {
          "type": "number",
          "minimum": 10,
          "maximum": 190
        },
        "top": {
          "type": "number",
          "minimum": 10,
          "maximum": 280
        },
        "width": {
          "type": "number",
          "minimum": 20,
          "maximum": 150
        },
        "height": {
          "type": "number",
          "minimum": 15,
          "maximum": 150
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[^\\s\\p{C}\\p{M}\\uD800-\\uDFFF\\u{10000}-\\u{10FFFF}]+$(?![\\s\\S])"
        },
        "writingMode": {
          "$ref": "#/$defs/writingMode"
        },
        "border": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "left",
        "top",
        "width",
        "height",
        "text"
      ]
    },
    "columnFormat": {
      "type": "object",
      "additionalProperties": false,
      "description": "Document-style column format (DocumentStyleColumns): the defaults that 2- and 3-column sections use. This alone does not put the body into columns; use paragraphs.columns for that. Whether a body section is rendered with this format cannot be read back and is not verified.",
      "properties": {
        "gapMm": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "description": "Common column gap in mm."
        },
        "rule": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15,
          "description": "Common column rule line type; 0 = none."
        },
        "twoColumn": {
          "type": "object",
          "additionalProperties": false,
          "description": "Document-style two-column format. Both gapMm and chars are required; Ichitaro calculates the character spacing.",
          "properties": {
            "gapMm": {
              "type": "number",
              "minimum": 0,
              "maximum": 50
            },
            "chars": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "gapMm",
            "chars"
          ]
        },
        "threeColumn": {
          "type": "object",
          "additionalProperties": false,
          "description": "Document-style three-column format. Both gapMm and chars are required; Ichitaro calculates the character spacing.",
          "properties": {
            "gapMm": {
              "type": "number",
              "minimum": 0,
              "maximum": 50
            },
            "chars": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "gapMm",
            "chars"
          ]
        }
      },
      "required": [],
      "minProperties": 1
    },
    "styleDefinition": {
      "type": "object",
      "additionalProperties": false,
      "description": "Document-local character or paragraph style. Only the size is set.",
      "properties": {
        "kind": {
          "enum": [
            "character",
            "paragraph"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]{0,15}$(?![sS])",
          "description": "ASCII style name (avoids Ichitaro system style names)."
        },
        "sizePt": {
          "type": "number",
          "minimum": 6,
          "maximum": 36
        }
      },
      "required": [
        "kind",
        "name",
        "sizePt"
      ]
    },
    "styleApplication": {
      "type": "object",
      "additionalProperties": false,
      "description": "Apply a defined style to a whole paragraph (zero-based). One style per paragraph.",
      "properties": {
        "paragraph": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "style": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]{0,15}$(?![sS])",
          "description": "ASCII style name (avoids Ichitaro system style names)."
        }
      },
      "required": [
        "paragraph",
        "style"
      ]
    },
    "pageNumber": {
      "type": "object",
      "additionalProperties": false,
      "description": "Document-style page number settings (DocumentStylePage). The printed page number text has no getter; only the stored settings are verified.",
      "properties": {
        "position": {
          "enum": [
            "none",
            "bottom-left",
            "bottom-center",
            "bottom-right",
            "top-left",
            "top-center",
            "top-right"
          ]
        },
        "marginMm": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "start": {
          "type": "integer",
          "minimum": -9,
          "maximum": 10000
        },
        "decoration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[ -~]+$(?![sS])",
          "description": "Stored decoration string (Ichitaro default reads \"- ? -\"). How Ichitaro substitutes the number into it is not verified."
        }
      },
      "required": [
        "position"
      ]
    },
    "typesetting": {
      "type": "object",
      "additionalProperties": false,
      "description": "Document-style typesetting (DocumentStyleRoman), read back by GetDocumentStyleRoman before save and after reopen.",
      "properties": {
        "justification": {
          "type": "boolean",
          "description": "ジャスティフィケーション: true = 必ず行末まで揃える (1), false = しない (0). The value 2 is rejected by Ichitaro."
        },
        "kinsoku": {
          "type": "boolean",
          "description": "禁則処理. false forces hanging, pushIn and bracketOverlap off."
        },
        "lineStartForbidden": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "行頭禁則文字. Complete replacement of the forbidden character list (non-whitespace BMP characters)."
        },
        "lineEndForbidden": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "行末禁則文字. Complete replacement of the forbidden character list (non-whitespace BMP characters)."
        },
        "hanging": {
          "type": "boolean",
          "description": "ぶら下げ. true requires pushIn: false."
        },
        "pushIn": {
          "type": "boolean",
          "description": "追い込み."
        },
        "bracketOverlap": {
          "type": "boolean",
          "description": "括弧類の重なり処理. false requires pushIn: false."
        }
      },
      "required": [],
      "minProperties": 1
    },
    "columnRange": {
      "type": "object",
      "additionalProperties": false,
      "description": "Apply columns only to paragraphs from..to (zero-based, inclusive); the paragraphs before and after stay one column. Must not cover the whole document.",
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "to": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "leadingParagraph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200,
          "pattern": "^[^\\s\\p{C}\\p{M}\\uD800-\\uDFFF\\u{10000}-\\u{10FFFF}]*$(?![\\s\\S])",
          "description": "0..200 BMP characters without whitespace; empty makes a blank line. A long paragraph wraps over several lines; the table starts on the line after the last paragraph. The paragraphs and the table must stay on the first page."
        },
        "sizePt": {
          "type": "number",
          "minimum": 6,
          "maximum": 36,
          "description": "Point size of this paragraph. Omitted: the document size."
        },
        "spacing": {
          "type": "object",
          "additionalProperties": false,
          "description": "Space before/after this paragraph, as for paragraph formats. mm: 0..10, percent: 0..100. A component not given is 0.",
          "properties": {
            "unit": {
              "enum": [
                "mm",
                "percent"
              ]
            },
            "before": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "after": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "unit"
          ],
          "minProperties": 2
        }
      },
      "required": [
        "text"
      ]
    }
  }
}
